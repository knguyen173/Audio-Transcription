import os
import pandas as pd
import yt_dlp
import stable_whisper
from pydub import AudioSegment

def process_speech_from_csv(youtube_url, csv_path):
    results_dir = 'results'
    os.makedirs(results_dir, exist_ok=True)
    
    print("1. Parsing unique sentences from CSV...")
    # Read the CSV. The sentences are repeated in the second column (index 1)
    df = pd.read_csv(csv_path, header=None)
    
    # Extract unique sentences, preserving order
    sentences = df[1].dropna().unique().tolist()
    
    # Join into a single string to bypass stable-whisper bugs
    full_text = " ".join(sentences)
    print(f"-> Extracted {len(sentences)} unique sentences.")

    print("\n2. Downloading audio from YouTube...")
    audio_filename = os.path.join(results_dir, 'full_speech.wav')
    ydl_opts = {
        'format': 'bestaudio/best',
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'wav',
        }],
        'outtmpl': os.path.join(results_dir, 'full_speech.%(ext)s'),
        'quiet': True
    }
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([youtube_url])
    print(f"-> Audio downloaded to {audio_filename}")

    print("\n3. Aligning text to audio (Ignoring applause with VAD)...")
    model = stable_whisper.load_model('base')
    
    # vad=True uses Silero to detect voice activity, making it highly 
    # accurate at ignoring intro music and loud applause blocks
    result = model.align(audio_filename, full_text, language='en', vad=True)

    print("\n4. Grouping word timestamps to bypass intro/outro noise...")
    audio = AudioSegment.from_wav(audio_filename)
    audio_dir = os.path.join(results_dir, 'clean_csv_audio_slices')
    os.makedirs(audio_dir, exist_ok=True)
    
    # Flatten all words from the aligned audio
    aligned_words = []
    for segment in result.segments:
        if getattr(segment, 'words', []):
            aligned_words.extend(segment.words)
            
    word_idx = 0
    total_words = len(aligned_words)
    sentences_data = []

    # Iterate through our target sentences from the CSV
    for i, sentence in enumerate(sentences):
        # We compare character length ignoring spaces/punctuation spacing
        sentence_no_spaces = sentence.replace(" ", "").replace("\u200b", "")
        current_matched_text = ""
        
        start_ms = None
        end_ms = None
        
        # Accumulate aligned words until we match the CSV sentence length
        while word_idx < total_words:
            w = aligned_words[word_idx]
            w_text = getattr(w, 'word', getattr(w, 'text', ''))
            
            # The start time is locked onto the FIRST word of the sentence
            if start_ms is None:
                start_ms = int(w.start * 1000)
                
            # The end time continuously updates to the end of the LATEST word
            end_ms = int(w.end * 1000)
            
            current_matched_text += w_text.replace(" ", "")
            word_idx += 1
            
            # If our accumulated text length matches the target sentence, cut it
            if len(current_matched_text) >= len(sentence_no_spaces):
                break
                
        # Safeguard if timestamps were missed
        if start_ms is None:
            start_ms, end_ms = 0, 0

        # Slice the audio based strictly on the first and last word's timestamps
        audio_slice = audio[start_ms:end_ms]
        slice_filename = os.path.join(audio_dir, f"sentence_{i+1}.wav")
        audio_slice.export(slice_filename, format="wav")
        
        sentences_data.append({
            'Segment_ID': i + 1,
            'Sentence_Text': sentence,
            'Start_Time_ms': start_ms,
            'End_Time_ms': end_ms
        })
        
    out_df = pd.DataFrame(sentences_data)
    csv_out_path = os.path.join(results_dir, 'clean_reagan_speech_sentences.csv')
    out_df.to_csv(csv_out_path, index=False)
    
    print(f"-> Success! {len(sentences_data)} true sentences saved in '{audio_dir}'.")

# --- Execution ---
if __name__ == "__main__":
    YOUTUBE_LINK = input("Please paste the YouTube link here and press Enter: ").strip()
    CSV_FILE = "Reagan_Second_Inaugural_Transcript - Sheet1.csv"
    
    if not YOUTUBE_LINK:
        print("Error: No YouTube link provided. Exiting.")
    else:
        process_speech_from_csv(YOUTUBE_LINK, CSV_FILE)