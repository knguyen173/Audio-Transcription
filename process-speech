import os
import pandas as pd
import yt_dlp
import stable_whisper
from pydub import AudioSegment

def process_and_clean_speech(youtube_url, transcript_path):
    results_dir = 'attempts'
    os.makedirs(results_dir, exist_ok=True)
    
    print("1. Parsing transcript...")
    with open(transcript_path, 'r', encoding='utf-8') as f:
        # Load as single block to prevent tokenizer crashes
        text = f.read().replace('\n', ' ').strip()

    print("\n2. Downloading audio from YouTube...")
    audio_filename = os.path.join(results_dir, 'full_speech.wav')
    ydl_opts = {
        'format': 'bestaudio/best',
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'wav',
        }],
        'outtmpl': os.path.join(results_dir, 'full_speech.%(ext)s'),
        'quiet': True
    }
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([youtube_url])
    print(f"-> Audio downloaded to {audio_filename}")

    print("\n3. Aligning text to audio and filtering non-speech...")
    model = stable_whisper.load_model('base')
    
    # vad=True enables Silero Voice Activity Detection to actively ignore 
    # silence, applause, and non-vocal audio during alignment
    result = model.align(audio_filename, text, language='en', vad=True)
    
    # Split specifically at sentence-ending punctuation
    result.split_by_punctuation(['.', '!', '?'])

    print("\n4. Generating CSV and slicing clean audio...")
    audio = AudioSegment.from_wav(audio_filename)
    audio_dir = os.path.join(results_dir, 'clean_audio_slices')
    os.makedirs(audio_dir, exist_ok=True)
    
    sentences_data = []

    for i, segment in enumerate(result.segments):
        # Skip if the segment somehow contains no recognized words
        if not getattr(segment, 'words', []):
            continue
            
        sentence_text = segment.text.strip()
        
        # KEY CHANGE: Target exact word boundaries to skip applause
        # Start at the exact millisecond the first word is spoken
        start_ms = int(segment.words[0].start * 1000)
        # End at the exact millisecond the last word finishes
        end_ms = int(segment.words[-1].end * 1000)
        
        audio_slice = audio[start_ms:end_ms]
        
        slice_filename = os.path.join(audio_dir, f"sentence_{i+1}.wav")
        audio_slice.export(slice_filename, format="wav")
        
        sentences_data.append({
            'Segment_ID': i + 1,
            'Sentence_Text': sentence_text,
            'Start_Time_ms': start_ms,
            'End_Time_ms': end_ms
        })
        
    df = pd.DataFrame(sentences_data)
    csv_path = os.path.join(results_dir, 'clean_speech_sentences.csv')
    df.to_csv(csv_path, index=False)
    
    print(f"-> Success! {len(sentences_data)} cleaned slices saved in '{audio_dir}'.")

# --- Execution ---
if __name__ == "__main__":
    # Prompt the user for the YouTube link in the terminal
    YOUTUBE_LINK = input("Please paste the YouTube link here and press Enter: ").strip()
    
    # Prompt for the transcript file (defaults to transcript.txt if left blank)
    TRANSCRIPT_FILE = input("Enter transcript filename (or press Enter to default to 'transcript.txt'): ").strip()
    if not TRANSCRIPT_FILE:
        TRANSCRIPT_FILE = "transcript.txt"
    
    if not YOUTUBE_LINK:
        print("Error: No YouTube link provided. Exiting.")
    else:
        process_and_clean_speech(YOUTUBE_LINK, TRANSCRIPT_FILE)